new file mode 100644
index 0000000..77b75fb
--- /dev/null
+++ b/internal/wemanage/collect.go
@@ -0,0 +1,146 @@
+package wemanage
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/jackc/pgx/v5"
+)
+
+const collectSchema = `
+CREATE TABLE IF NOT EXISTS wm_desktop_exports (
+ id bigserial PRIMARY KEY, employee_id bigint NOT NULL REFERENCES employees(id), agent text NOT NULL,
+ project text NOT NULL, title text NOT NULL, content_hash text NOT NULL, content text NOT NULL,
+ received_at timestamptz NOT NULL DEFAULT now(), UNIQUE(employee_id,agent,project,title,content_hash)
+);
+CREATE INDEX IF NOT EXISTS wm_desktop_exports_owner_id ON wm_desktop_exports(employee_id,id DESC);`
+
+var collectAgents = map[string]bool{"WorkBuddy": true, "Claude Code": true, "Cursor": true, "Codex": true, "豆包工作": true, "千问工作": true, "其他 Agent": true}
+
+func (s *Service) collectExport(w http.ResponseWriter, r *http.Request) {
+	var in struct {
+		Agent, Project, Title, Content string
+		Owner                          int64
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 8<<20)
+	d := json.NewDecoder(r.Body)
+	d.DisallowUnknownFields()
+	if err := d.Decode(&in); err != nil {
+		var tooLarge *http.MaxBytesError
+		if errors.As(err, &tooLarge) {
+			fail(w, 413, "记录超出上传大小")
+			return
+		}
+		fail(w, 400, "记录格式无效")
+		return
+	}
+	if d.Decode(new(any)) != io.EOF {
+		fail(w, 400, "记录格式无效")
+		return
+	}
+	owner := who(r).employee.ID
+	if in.Owner != owner {
+		fail(w, 409, "登录成员已变化，请重新确认同步")
+		return
+	}
+	validLabel := func(v string) bool {
+		return strings.TrimSpace(v) != "" && utf8.RuneCountInString(v) <= 256 && !strings.ContainsRune(v, 0)
+	}
+	if !collectAgents[in.Agent] || !validLabel(in.Project) || !validLabel(in.Title) || strings.TrimSpace(in.Content) == "" || strings.ContainsRune(in.Content, 0) {
+		fail(w, 400, "来源、项目、标题或正文无效")
+		return
+	}
+	if len(in.Content) > 1<<20 {
+		fail(w, 413, "正文超过 1 MiB，未上传")
+		return
+	}
+	hash := sha256.Sum256([]byte(in.Content))
+	sum := hex.EncodeToString(hash[:])
+	var id int64
+	err := s.Store.Pool.QueryRow(r.Context(), `INSERT INTO wm_desktop_exports(employee_id,agent,project,title,content_hash,content)
+	VALUES ($1,$2,$3,$4,$5,$6) ON CONFLICT DO NOTHING RETURNING id`, owner, in.Agent, in.Project, in.Title, sum, in.Content).Scan(&id)
+	if errors.Is(err, pgx.ErrNoRows) {
+		err = s.Store.Pool.QueryRow(r.Context(), `SELECT id FROM wm_desktop_exports WHERE employee_id=$1 AND agent=$2 AND project=$3 AND title=$4 AND content_hash=$5`, owner, in.Agent, in.Project, in.Title, sum).Scan(&id)
+	}
+	if err != nil {
+		fail(w, 500, "保存失败，请稍后重试")
+		return
+	}
+	reply(w, 200, map[string]any{"id": id, "sha256": sum})
+}
+
+func (s *Service) myExports(w http.ResponseWriter, r *http.Request) {
+	if raw := r.URL.Query().Get("id"); raw != "" {
+		id, err := strconv.ParseInt(raw, 10, 64)
+		if err != nil || id < 1 {
+			fail(w, 400, "记录编号无效")
+			return
+		}
+		var content string
+		err = s.Store.Pool.QueryRow(r.Context(), "SELECT content FROM wm_desktop_exports WHERE id=$1 AND employee_id=$2", id, who(r).employee.ID).Scan(&content)
+		if errors.Is(err, pgx.ErrNoRows) {
+			fail(w, 404, "记录不存在")
+			return
+		}
+		if err != nil {
+			fail(w, 500, "读取失败")
+			return
+		}
+		reply(w, 200, map[string]any{"content": content})
+		return
+	}
+	q := r.URL.Query().Get("q")
+	if utf8.RuneCountInString(q) > 200 {
+		fail(w, 400, "搜索词过长")
+		return
+	}
+	before := int64(0)
+	if raw := r.URL.Query().Get("before"); raw != "" {
+		var err error
+		before, err = strconv.ParseInt(raw, 10, 64)
+		if err != nil || before < 1 {
+			fail(w, 400, "分页位置无效")
+			return
+		}
+	}
+	rows, err := s.Store.Pool.Query(r.Context(), `SELECT id,agent,project,title,received_at FROM wm_desktop_exports WHERE employee_id=$1 AND ($3::bigint=0 OR id<$3) AND ($2='' OR strpos(lower(concat_ws(' ',agent,project,title,content)),lower($2))>0) ORDER BY id DESC LIMIT 51`, who(r).employee.ID, q, before)
+	if err != nil {
+		fail(w, 500, "查询失败")
+		return
+	}
+	defer rows.Close()
+	type entry struct {
+		ID      int64     `json:"id"`
+		Agent   string    `json:"agent"`
+		Project string    `json:"project"`
+		Title   string    `json:"title"`
+		At      time.Time `json:"at"`
+	}
+	result := []entry{}
+	for rows.Next() {
+		var e entry
+		if rows.Scan(&e.ID, &e.Agent, &e.Project, &e.Title, &e.At) != nil {
+			fail(w, 500, "读取失败")
+			return
+		}
+		result = append(result, e)
+	}
+	if rows.Err() != nil {
+		fail(w, 500, "读取失败")
+		return
+	}
+	var next int64
+	if len(result) > 50 {
+		result = result[:50]
+		next = result[49].ID
+	}
+	reply(w, 200, map[string]any{"records": result, "next": next})
+}
