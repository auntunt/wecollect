index 0000000..4131dba
--- /dev/null
+++ b/internal/wemanage/collect_test.go
@@ -0,0 +1,105 @@
+package wemanage_test
+
+import (
+	"aiseat/internal/store"
+	"aiseat/internal/testutil"
+	"aiseat/internal/wemanage"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDesktopExportReceipts(t *testing.T) {
+	u, _ := url.Parse(testutil.TestDBURL())
+	if u == nil || u.Hostname() != "127.0.0.1" || u.Path != "/wecollect_pilot_test" {
+		t.Skip("requires isolated local wecollect_pilot_test database")
+	}
+	ctx := context.Background()
+	st := store.New(testutil.NewDB(t))
+	if e := wemanage.Install(ctx, st); e != nil {
+		t.Fatal(e)
+	}
+	type member struct {
+		id           int64
+		cookie, csrf string
+	}
+	create := func(name string) member {
+		e, err := st.UpsertEmployeeByOpenID(ctx, store.Employee{FeishuOpenID: name, Name: name})
+		if err != nil {
+			t.Fatal(err)
+		}
+		c, k, err := st.CreateWebSession(ctx, e.ID, time.Hour)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return member{e.ID, c, k}
+	}
+	a, b := create("pilot-a"), create("pilot-b")
+	srv := httptest.NewServer((&wemanage.Service{Store: st}).Handler())
+	defer srv.Close()
+	call := func(method string, user member, body string, code int) string {
+		req, _ := http.NewRequest(method, srv.URL+"/api/desktop-exports", strings.NewReader(body))
+		req.AddCookie(&http.Cookie{Name: "aiseat_sess", Value: user.cookie})
+		req.Header.Set("X-CSRF-Token", user.csrf)
+		resp, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		v, _ := io.ReadAll(resp.Body)
+		if resp.StatusCode != code {
+			t.Fatalf("got %d wanted %d: %s", resp.StatusCode, code, v)
+		}
+		return string(v)
+	}
+	for _, agent := range []string{"WorkBuddy", "Claude Code", "Cursor", "Codex", "豆包工作", "千问工作"} {
+		body, _ := json.Marshal(map[string]any{"agent": agent, "project": "试用项目", "title": "记录.md", "content": "原文\n\n尾行", "owner": a.id})
+		first := call("POST", a, string(body), 200)
+		if first != call("POST", a, string(body), 200) {
+			t.Fatal("duplicate produced different receipt")
+		}
+		call("POST", b, string(body), 409)
+		call("POST", member{a.id, a.cookie, "wrong"}, string(body), 403)
+	}
+	call("GET", member{}, "", 401)
+	if strings.Contains(call("GET", b, "", 200), "记录.md") {
+		t.Fatal("cross-employee record")
+	}
+	var sampleID int64
+	if err := st.Pool.QueryRow(ctx, "select min(id) from wm_desktop_exports where employee_id=$1", a.id).Scan(&sampleID); err != nil {
+		t.Fatal(err)
+	}
+	req, _ := http.NewRequest("GET", srv.URL+"/api/desktop-exports?id="+strconv.FormatInt(sampleID, 10), nil)
+	req.AddCookie(&http.Cookie{Name: "aiseat_sess", Value: b.cookie})
+	denied, e := http.DefaultClient.Do(req)
+	if e != nil {
+		t.Fatal(e)
+	}
+	denied.Body.Close()
+	if denied.StatusCode != 404 {
+		t.Fatalf("another member can fetch content: %d", denied.StatusCode)
+	}
+	var count int
+	if err := st.Pool.QueryRow(ctx, "select count(*) from wm_desktop_exports where employee_id=$1 and content=$2", a.id, "原文\n\n尾行").Scan(&count); err != nil || count != 6 {
+		t.Fatalf("count=%d err=%v", count, err)
+	}
+	if os.Getenv("WECOLLECT_BROWSER_TEST") == "1" {
+		cmd := exec.Command("python3", "../wecollectui/testdata/browser.py")
+		cmd.Env = append(os.Environ(), "WECOLLECT_TEST_ORIGIN="+srv.URL, "WECOLLECT_TEST_COOKIE="+a.cookie)
+		if output, e := cmd.CombinedOutput(); e != nil {
+			t.Fatalf("%v: %s", e, output)
+		}
+		if err := st.Pool.QueryRow(ctx, "select count(*) from wm_desktop_exports where project='浏览器测试'").Scan(&count); err != nil || count != 1 {
+			t.Fatalf("browser inserted %d, %v", count, err)
+		}
+	}
+}
